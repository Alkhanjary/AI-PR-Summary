LLM_API_KEY=your-ollama-cloud-api-key
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:20b-cloud

# Optional: a GitHub personal access token, used by the dashboard's GitHub
# API calls for a much higher rate limit and access to private repos.
# Without it, the dashboard still works but is limited to GitHub's low
# unauthenticated rate limit and public repos only.
GITHUB_TOKEN=
